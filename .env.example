# Copy to .env and fill in the key for your provider. Hazzel reads
# .env from your project root on startup. Real environment variables
# always win over .env, and .env is gitignored, so keys stay local.
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
